# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public demo account (optional).
# When both are set, the login screen shows a one-tap "Try the live demo"
# button. Server-only — never prefix these with NEXT_PUBLIC.
# Populate the account's history with: npm run seed:demo
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=change-me
